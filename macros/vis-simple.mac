# Simple visual smoke test for baseLab.
#
# This is the minimal visualization example for interactive inspection of the
# detector shell, end-cap scorer, and source beam arrangement.

/control/macroPath .:macros:../macros

# Minimal geometry setup.
/baseLab/geometry/worldSize 2.5 m
/baseLab/geometry/sampleDepth 10 cm
/baseLab/geometry/sampleRadius 5 cm
/baseLab/geometry/sampleThickness 1 mm
/baseLab/geometry/sampleSkinThickness 0.25 mm
/baseLab/geometry/sampleEndCapArea 1 cm2
/baseLab/geometry/sampleEndCapThickness 0.25 mm

# Keep the run in a clean visual smoke-test state.
/run/initialize
/vis/open OGL
/control/execute vis.mac

# Source composition pattern and a short beam for easy viewing.
/control/execute source-co60.mac

/gps/pos/type Point
/gps/pos/centre 0 0 -0.75 m
/gps/ang/type iso

/run/printProgress 1
/run/beamOn 5
