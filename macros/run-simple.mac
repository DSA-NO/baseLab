# Simple batch smoke test for baseLab.
#
# This is the minimal reference run for quick validation of geometry,
# source composition, and beam delivery without the full reference-suite setup.
#
# Keep nested macro resolution robust in both repo-root and build-directory runs.
/control/macroPath .:macros:../macros

# Minimal geometry setup for the sample shell and end-cap scorer.
/baseLab/geometry/worldSize 2.5 m
/baseLab/geometry/sampleDepth 10 cm
/baseLab/geometry/sampleRadius 5 cm
/baseLab/geometry/sampleThickness 1 mm
/baseLab/geometry/sampleSkinThickness 0.25 mm
/baseLab/geometry/sampleEndCapArea 1 cm2
/baseLab/geometry/sampleEndCapThickness 0.25 mm

# Output metadata for a quick smoke test.
/baseLab/output/tag run-simple
/baseLab/output/source co60
/baseLab/output/geometry waterbox
/baseLab/output/region sample
/baseLab/output/depth 10 cm

/run/initialize

# Source composition pattern: source preset only; no /run/initialize here.
/control/execute source-co60.mac

# Simple beam setup.
/gps/pos/type Point
/gps/pos/centre 0 0 -0.75 m
/gps/ang/type iso

/run/printProgress 20
/run/beamOn 100
